<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#071827"
                android:centerColor="#0B2140"
                android:endColor="#24135A" />
        </shape>
    </item>

    <item android:left="-80dp" android:top="-120dp">
        <shape android:shape="oval">
            <size android:width="260dp" android:height="260dp" />
            <solid android:color="#3342F5E8" />
        </shape>
    </item>

    <item android:right="-100dp" android:bottom="-120dp" android:gravity="bottom|right">
        <shape android:shape="oval">
            <size android:width="300dp" android:height="300dp" />
            <solid android:color="#338A3FFC" />
        </shape>
    </item>

    <item android:gravity="center" android:width="168dp" android:height="168dp">
        <shape android:shape="oval">
            <solid android:color="#2242F5E8" />
        </shape>
    </item>

    <item android:gravity="center" android:width="120dp" android:height="120dp">
        <shape android:shape="rectangle">
            <corners android:radius="34dp" />
            <gradient
                android:angle="135"
                android:startColor="#42F5E8"
                android:centerColor="#6477FF"
                android:endColor="#8A3FFC" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>

    <item android:gravity="center" android:width="74dp" android:height="74dp" android:drawable="@drawable/assistant_star" />
</layer-list>
